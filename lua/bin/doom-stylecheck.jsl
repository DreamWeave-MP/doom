--!strict
-- The source-tree style gate, implemented using Jess's bundled style checker.
local style = require('@jess/style')

local paths: {string} = {}
for index, path in arg do if index ~= 0 then table.insert(paths, path) end end

if #paths == 0 then
    -- Generated lookup tables, the play simulation (which keeps the C sources' names so
    -- the two read side by side), and the older port modules keep their existing format.
    paths = {
        'lua/src/net.jsl',
        'lua/src/content.jsl',
        'lua/src/session/init.jsl',
        'lua/src/session/common.jsl',
        'lua/src/session/host.jsl',
        'lua/src/session/client.jsl',
        'lua/src/session/replay.jsl',
        'lua/bin/doom-peer.jsl',
        'lua/bin/doom-netcheck.jsl',
        'lua/src/mod/init.jsl',
        'lua/src/rules/init.jsl',
        'lua/src/setup.jsl',
        'lua/src/app/clock.jsl',
        'lua/src/app/display.jsl',
        'lua/src/app/controls.jsl',
        'lua/src/app/options.jsl',
        'lua/src/app/entry.jsl',
        'lua/src/app/main.jsl',
        'lua/tests/rules_test.jsl',
        'lua/src/testing.jsl',
        'mods/arsenal/src/arsenal.jsl',
        'mods/arsenal/src/managed.jsl',
        'mods/arsenal/tests/arsenal_test.jsl',
        'mods/coop-director/src/director.jsl',
        'mods/coop-director/src/managed.jsl',
        'mods/coop-director/tests/director_test.jsl',
        'mods/modpack/src/entry.jsl',
        'lua/tests/net_test.jsl',
        'lua/bin/doom-stylecheck.jsl',
        'lua/src/agent.jsl',
        'lua/src/init.jsl',
        'lua/bin/doom.jsl',
        'lua/bin/doom-arena.jsl',
        'lua/bin/doom-agent.jsl',
        'lua/src/spectator.jsl',
        'lua/src/screens.jsl',
        'lua/src/screens/draw.jsl',
        'lua/src/screens/finale.jsl',
        'lua/src/screens/intermission.jsl',
        'lua/src/screens/menu.jsl',
        'lua/src/screens/text.jsl',
        'lua/tests/screens_test.jsl',
        'lua/src/sound/init.jsl',
        'lua/src/sound/dmx.jsl',
        'lua/src/sound/mus.jsl',
        'lua/src/sound/sfx.jsl',
        'lua/src/sound/synth.jsl',
        'lua/tests/sound_test.jsl',
    }
end

local errors, warnings = style.run(paths)
print(`Doom Luau style: {errors} errors, {warnings} warnings`)
if errors > 0 then error('doom style check failed') end
