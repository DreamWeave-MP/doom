--!strict
-- sounds.c's S_sfx: every sound effect by its name without the `sfx_` prefix, in the
-- original's order. `priority` decides which sound a full set of channels gives up (the
-- lower, the more it matters); `singularity` is unused by the original too. A `link` plays
-- another sound's lump at `pitch` (128 is unchanged), `volume` added to the level.

export type Sfx = {
  name: string,
  index: number,
  singularity: boolean,
  priority: number,
  link: string?,
  pitch: number,
  volume: number,
}

local byName: { [string]: Sfx } = {}
local count = 0

local function add(name: string, singularity: boolean, priority: number, link: string?, pitch: number?, volume: number?): ()
  count += 1
  byName[name] = {
    name = name,
    index = count,
    singularity = singularity,
    priority = priority,
    link = link,
    pitch = pitch or 128,
    volume = volume or 0,
  }
end

-- sfx_pistol (1) first.
