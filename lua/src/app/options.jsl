--!strict
-- The application's command line, vanilla-shaped (`-iwad`, `-file`, `-warp`, `-skill`) with the
-- network switches beside it. The entry parses the target's arguments into the table this module
-- returns; the managed modules read it at startup. A module loads once per domain, so the entry
-- and the managed modules share this one table.
local module = {}

export type Options = {
  iwad: string?,
  files: { string },
  warp: string?,
  skill: number,
  host: string?,
  join: string?,
  name: string,
  players: number,
  mode: string,
  teamDamage: boolean,
  keepInventory: boolean,
  fragLimit: number,
  timeLimit: number,
  scale: number,
  noSound: boolean,
  noMusic: boolean,
  fullscreen: boolean,
  frames: number?,
}

function module.defaults(): Options
  return {
    files = {},
    skill = 3,
    name = 'player',
    players = 2,
    mode = 'coop',
    teamDamage = false,
    keepInventory = false,
    fragLimit = 0,
    timeLimit = 0,
    scale = 3,
    noSound = false,
    noMusic = false,
    fullscreen = false,
  }
end

local current = module.defaults()

module.current = current

-- A switch: how many values follow it (`'list'` takes every value up to the next switch) and what
-- they set. `apply` gets the switch's own name for its error messages.
type Switch = {
  values: number | 'list',
  apply: (options: Options, values: { string }, name: string) -> (),
}

local function number(values: { string }, name: string): number
  local value = tonumber(values[1])
  if not value then error(`doom: {name} takes a number, not '{values[1]}'`, 0) end

  return value
end

-- A switch that sets one number, held between `minimum` and `maximum`.
local function numeric(field: string, minimum: number, maximum: number): Switch
  return {
    values = 1,
    apply = function(options: Options, values: { string }, name: string)
      (options :: any)[field] = math.clamp(number(values, name), minimum, maximum)
    end,
  }
end

-- A switch that sets one text value.
local function text(field: string): Switch
  return {
    values = 1,
    apply = function(options: Options, values: { string })
      (options :: any)[field] = values[1]
    end,
  }
end

-- A switch that turns a setting on.
local function flag(field: string): Switch
  return {
    values = 0,
    apply = function(options: Options)
      (options :: any)[field] = true
    end,
  }
end

local Modes = { coop = true, ffa = true, tdm = true }

local Switches: { [string]: Switch } = {
  ['-iwad'] = text('iwad'),
  ['-file'] = {
    values = 'list',
    apply = function(options: Options, values: { string })
      table.move(values, 1, #values, #options.files + 1, options.files)
    end,
  },
  -- `-warp 2 3` is E2M3 and `-warp 7` MAP07, as vanilla read them; anything else is a map's name.
  ['-warp'] = {
    values = 'list',
    apply = function(options: Options, values: { string }, name: string)
      local first, second = values[1], values[2]
      if not first or #values > 2 then error(`doom: {name} takes an episode and a map, a map number, or a map name`, 0) end

      if second then
        options.warp = `E{number({ first }, name)}M{number({ second }, name)}`
      elseif tonumber(first) then
        options.warp = string.format('MAP%02d', tonumber(first) :: number)
      else
        options.warp = string.upper(first)
      end
    end,
  },
  ['-skill'] = numeric('skill', 1, 5),
  ['-host'] = text('host'),
  ['-join'] = text('join'),
  ['-name'] = text('name'),
  ['-players'] = numeric('players', 1, 4),
  ['-mode'] = {
    values = 1,
    apply = function(options: Options, values: { string }, name: string)
      if not Modes[values[1]] then error(`doom: {name} is coop, ffa or tdm, not '{values[1]}'`, 0) end

      options.mode = values[1]
    end,
  },
  ['-teamdamage'] = flag('teamDamage'),
  ['-keepinventory'] = flag('keepInventory'),
  ['-fraglimit'] = numeric('fragLimit', 0, 1000),
  ['-timelimit'] = numeric('timeLimit', 0, 1000),
  ['-scale'] = numeric('scale', 1, 8),
  ['-nosound'] = flag('noSound'),
  ['-nomusic'] = flag('noMusic'),
  ['-fullscreen'] = flag('fullscreen'),
  ['-frames'] = numeric('frames', 1, math.huge),
}

local function isSwitch(argument: string?): boolean
  return argument ~= nil and string.sub(argument, 1, 1) == '-' and tonumber(argument) == nil
end

-- Parses `arguments` into a fresh options table. Unknown switches are errors: a misspelled
-- `-iwad` that silently started the wrong game would be worse.
function module.parse(arguments: { string }): Options
  local parsed = module.defaults()
  local index = 1
  while index <= #arguments do
    local name = string.lower(arguments[index])
    local switch = Switches[name]
    if not switch then error(`doom: unknown switch '{arguments[index]}'`, 0) end

    index += 1
    local values: { string } = {}
    if switch.values == 'list' then
      while index <= #arguments and not isSwitch(arguments[index]) do
        table.insert(values, arguments[index])
        index += 1
      end
    else
      for _ = 1, switch.values :: number do
        if index > #arguments then error(`doom: {name} takes a value`, 0) end

        table.insert(values, arguments[index])
        index += 1
      end
    end

    switch.apply(parsed, values, name)
  end

  return parsed
end

-- Replaces the shared options with `parsed`, in place, so every holder of the table sees them.
function module.apply(parsed: Options): ()
  table.clear(current :: any)
  for key, value in parsed :: any do
    (current :: any)[key] = value
  end
end

-- The IWADs looked for, in vanilla's order of preference, when `-iwad` names none.
module.IwadNames = {
  'doom2.wad',
  'plutonia.wad',
  'tnt.wad',
  'doom.wad',
  'doom1.wad',
  'freedoom2.wad',
  'freedoom1.wad',
}

return module
