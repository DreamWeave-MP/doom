--!nonstrict
-- @doom/spectator: a live window onto a game, each player's first-person view in a grid.
--
-- The software renderer draws each view into DOOM's indexed 8-bit frame as it always has; the
-- frames are laid side by side in one indexed texture, which the GPU colors through the palette
-- at the window's size. Every show draws the views again and pumps the window.
local mapModule = require('@doom/map')
local render = require('@doom/render')

local shader = jess.shader

local FracUnit = 65536
local FrameWidth, FrameHeight = 320, 200

local module = {}

-- A triangle covering the target, from the vertex index alone.
local function covering(input: any): any
  local index = input.builtin.vertexIndex
  local corner = shader.vec2(
    shader.float(shader.bitAnd(shader.shiftLeft(index, shader.uint(1)), shader.uint(2))),
    shader.float(shader.bitAnd(index, shader.uint(2)))
  )

  return { position = shader.vec4(corner * 2 - 1, 0, 1) }
end

-- Each pixel's palette entry: the indexed texel under it, the frames scaled to the window.
local function paletted(width: number, height: number, columns: number, rows: number): any
  return shader.program {
    material = { frames = shader.texture2d, palette = shader.texture2d },
    vertex = covering,
    fragment = function(input)
      local scale = shader.vec2(FrameWidth * columns / width, FrameHeight * rows / height)
      local at = shader.vec2u(input.builtin.position.xy * scale)
      local index = shader.uint(shader.round(shader.load(input.material.frames, at, 0).x * 255))

      return shader.load(input.material.palette, shader.vec2u(index, shader.uint(0)), 0)
    end,
  }
end

-- Where slot `slot` stands and looks, and every other thing it can see drawn.
local function viewOf(game: any, slot: number): (number, number, number, { any })
  local own = game.players[slot].mo
  local things = {}
  local cap = game.thinkercap
  local thinker = cap.next
  while thinker ~= cap do
    if thinker.think == 'mobj' and thinker ~= own then table.insert(things, thinker) end
    thinker = thinker.next
  end

  return own.x / FracUnit, own.y / FracUnit, own.angle * 360 / 4294967296, things
end

-- Opens a window for `slots` players' views, two across, `scale` window pixels to a frame pixel.
function module.open(slots: number, scale: number?, title: string?): any
  local columns = if slots > 1 then 2 else 1
  local rows = math.ceil(slots / columns)
  local factor = scale or 2
  local device = jess.gpu.device()
  local window = jess.gpu.window(device, {
    title = title or 'DOOM',
    width = FrameWidth * columns * factor,
    height = FrameHeight * rows * factor,
    resizable = false,
  })
  local format = assert(window.format, 'the window closed before it was shown')

  local frames = device:texture {
    width = FrameWidth * columns,
    height = FrameHeight * rows,
    format = 'r8Unorm',
    usage = 'sampled',
  }
  local palette = device:texture { width = 256, height = 1, format = 'rgba8Unorm', usage = 'sampled' }
  local program = paletted(window.width, window.height, columns, rows)
  local pipeline = device:pipeline(program, { colors = { format } })
  local material = {}
  for _, binding in program.layout.material.bindings do
    if binding.kind == 'Sampler' then
      material[binding.binding] = device:sampler()
    elseif binding.name == 'frames' then
      material[binding.binding] = frames
    else
      material[binding.binding] = palette
    end
  end

  local plan = device:plan {
    name = 'spectator',
    viewport = { width = window.width, height = window.height },
    targets = { { name = 'screen', format = format, imported = true } },
    passes = {
      {
        name = 'palette',
        kind = 'fullscreen',
        pipeline = pipeline,
        material = pipeline:bind('material', material),
        colors = { 'screen' },
      },
    },
  }
  window:show(plan, 'screen')

  return {
    window = window,
    frames = frames,
    palette = palette,
    columns = columns,
    slots = slots,
    pixels = buffer.create(FrameWidth * columns * FrameHeight * rows),
    colors = buffer.create(1024),
    map = nil,
    mapName = nil,
  }
end

-- Draws every slot's view of `game` into the window. False once the person closed it.
function module.show(spectator: any, game: any): boolean
  if not spectator.window.open then return false end

  if spectator.mapName ~= game.mapname then
    spectator.map, spectator.mapName = mapModule.load(game.wad, game.mapname), game.mapname
  end

  local stride = FrameWidth * spectator.columns
  local palette = nil
  for slot = 0, spectator.slots - 1 do
    local player = game.players[slot]
    if not (player and player.mo) then continue end

    local east, north, angle, things = viewOf(game, slot)
    local frame, colors = render.view(spectator.map, game.wad, east, north, angle, things)
    palette = colors
    local left = (slot % spectator.columns) * FrameWidth
    local top = (slot // spectator.columns) * FrameHeight
    for row = 0, FrameHeight - 1 do
      buffer.copy(spectator.pixels, (top + row) * stride + left, frame.pixels, row * FrameWidth, FrameWidth)
    end
  end

  if palette then
    for entry = 0, 255 do
      buffer.writeu8(spectator.colors, entry * 4, buffer.readu8(palette.rgb, entry * 3))
      buffer.writeu8(spectator.colors, entry * 4 + 1, buffer.readu8(palette.rgb, entry * 3 + 1))
      buffer.writeu8(spectator.colors, entry * 4 + 2, buffer.readu8(palette.rgb, entry * 3 + 2))
      buffer.writeu8(spectator.colors, entry * 4 + 3, 255)
    end

    spectator.palette:write(spectator.colors)
  end

  spectator.frames:write(spectator.pixels)
  jess.gpu.pump()

  return spectator.window.open
end

return module
