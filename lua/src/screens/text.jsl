local PressKey = 'press a key.'
local PressYesNo = 'press y or n.'

module.Messages = {
  loadNet = `you can't do load while in a net game!\n\n{PressKey}`,
  saveDead = `you can't save if you aren't playing!\n\n{PressKey}`,
  newGame = `you can't start a new game\nwhile in a network game.\n\n{PressKey}`,
  nightmare = `are you sure? this skill level\nisn't even remotely fair.\n\n{PressYesNo}`,
  shareware = `this is the shareware version of doom.\n\nyou need to order the entire trilogy.\n\n{PressKey}`,
  netEnd = `you can't end a netgame!\n\n{PressKey}`,
  endGame = `are you sure you want to end the game?\n\n{PressYesNo}`,
}

module.EmptySlot = 'empty slot'

-- dstrings.c's quit messages, DOOM's and DOOM II's, each led by the plain question.
module.QuitMessages = {
