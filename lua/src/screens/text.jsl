-- F_StartFinale's flats: a doom1 episode's, then a commercial map's.
local EpisodeFlats = { 'FLOOR4_8', 'SFLR6_1', 'MFLR8_4', 'MFLR8_3' }
local MapFinales = {
  [6] = { number = 1, flat = 'SLIME16' },
  [11] = { number = 2, flat = 'RROCK14' },
  [20] = { number = 3, flat = 'RROCK07' },
  [30] = { number = 4, flat = 'RROCK17' },
  [15] = { number = 5, flat = 'RROCK13' },
  [31] = { number = 6, flat = 'RROCK19' },
}

local MissionPrefixes = { doom2 = 'C', plutonia = 'P', tnt = 'T' }

-- The finale after `map` of `episode`: its text's key in `Finale` and its background flat, or
-- nil for a commercial map with no interlude.
function module.finale(mission: Mission, episode: number, map: number): (string?, string?)
  if mission == 'doom' then
    local number = math.clamp(episode, 1, 4)
    return `E{number}TEXT`, EpisodeFlats[number]
  end

  local entry = MapFinales[map]
  if not entry then return nil, nil end

  return `{MissionPrefixes[mission]}{entry.number}TEXT`, entry.flat
end

-- Which game a WAD is. Final DOOM's two IWADs are DOOM II's game with their own finale texts;
-- they are told apart by file name, then by a patch only each of them carries.
function module.mission(wad: any): Mission
  if not wad:find('MAP01') then return 'doom' end

  local path = string.lower(tostring(wad.path or ''))
  local file = string.match(path, '([^/\\]+)$') or path
  if string.find(file, 'plutonia', 1, true) then return 'plutonia' end
  if string.find(file, 'tnt', 1, true) then return 'tnt' end
  if wad:find('CAVERN5') then return 'tnt' end
  if wad:find('MC1') and wad:find('MC20') then return 'plutonia' end

  return 'doom2'
end

