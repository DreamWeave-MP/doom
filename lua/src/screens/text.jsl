--!strict
-- The words of the front-end screens, from Linux Doom 1.10's d_englsh.h and dstrings.c: the
-- finale texts of every IWAD, the cast call's names, the menu's messages, and the quit
-- messages. The play simulation picks a finale by key here; the screens draw the text.
local module = {}

export type Mission = 'doom' | 'doom2' | 'plutonia' | 'tnt'

-- The finale texts by their d_englsh.h names. F_TextWrite starts a new line of 11 pixels at
-- each newline.
