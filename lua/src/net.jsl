--!strict
-- @doom/net: DOOM's dream-net wire protocol, version 2.
--
-- The transport is dream.udp (dream-net): authenticated connect tokens the host mints, one
-- reliable ordered channel for everything that must arrive in order, and one unreliable channel
-- for state hashes, which a later hash supersedes. The protocol owns no game state; the sessions
-- in @doom/session decide what every message means.
--
--   HELLO     client -> host   who is joining: name, team wanted, the content manifest
--   WELCOME   host -> client   the slot, the rules, the phase (lobby or game)
--   REJECT    host -> client   why not, before the host disconnects it
--   LOBBY     host -> clients  who is in, ready, on which team
--   READY     client -> host   ready or not, and the team wanted
--   START     host -> clients  the game everyone starts at tic 0
--   SNAPSHOT  host -> client   the whole game at a tic, for a player joining late or resyncing
--   TICS      host -> clients  one tic: its control events and every present player's command
--   CMD       client -> host   one local tic's command, numbered
--   HASH      both ways        the state hash after a tic
--   RESYNC    client -> host   a client that found itself out of step asks for a snapshot
--   BYE       both ways        leaving, and why
--   CHAT      both ways        a line of text
local bytes = require('@dream/bytes')
local state = require('@doom/state')
local udp = require('@dream/udp')

local module = {}

module.SchemaVersion = 2
module.CodecVersion = 2
module.ProtocolId = 0x444f6f6d00000002i
module.CommandSize = 5
module.MaxPlayers = 4
module.MaxControlPayload = 16384
module.MaxSnapshot = 64 * 1024 * 1024
module.SnapshotPart = 16384
module.PollBufferSize = 32768

export type EventName =
  'HELLO'
  | 'WELCOME'
  | 'REJECT'
  | 'LOBBY'
  | 'READY'
  | 'START'
  | 'SNAPSHOT'
  | 'TICS'
  | 'CMD'
  | 'HASH'
  | 'RESYNC'
  | 'BYE'
  | 'CHAT'

local EventNames: { EventName } = {
  'HELLO',
  'WELCOME',
  'REJECT',
  'LOBBY',
  'READY',
  'START',
  'SNAPSHOT',
  'TICS',
  'CMD',
  'HASH',
  'RESYNC',
  'BYE',
  'CHAT',
}

-- A ticcmd as the simulation reads it.
export type Command = { forwardmove: number, sidemove: number, angleturn: number, buttons: number }

-- What changes between tics, as the host decided, applied at the start of the tic it rides on.
export type Control =
  { kind: 'join', slot: number, team: number? }
  | { kind: 'leave', slot: number }
  | { kind: 'map', map: string }
  | { kind: 'pause', paused: boolean }
  | { kind: 'exit', secret: boolean }

export type Tic = { tic: number, controls: { Control }, commands: { [number]: Command } }

export type Protocol = { schema: dream_udp_Schema, ids: { [EventName]: integer }, names: { [integer]: EventName } }

local function fail(message: string): never
  error(`doom.net: {message}`, 3)
end

local function whole(value: number, name: string, minimum: number, maximum: number): number
  if type(value) ~= 'number' or value ~= math.floor(value) or value < minimum or value > maximum then
    fail(`{name} must be a whole number from {minimum} to {maximum}, not {tostring(value)}`)
  end

  return value
end

function module.protocol(): Protocol
  local control = { channel = 'game', maxPayload = module.MaxControlPayload, codecVersion = module.CodecVersion }
  local events = {}
  for _, name in EventNames do
    local event = table.clone(control) :: { [string]: any }
    event.name = name
    if name == 'SNAPSHOT' then event.maxPayload = 12 + module.SnapshotPart end
    if name == 'HASH' then event.channel, event.maxPayload = 'hash', 8 end
    if name == 'CMD' then event.maxPayload = 4 + module.CommandSize end
    table.insert(events, event)
  end

  local schema = udp.schema {
    version = module.SchemaVersion,
    maxMessagesPerPacket = 64,
    channels = {
      { name = 'game', delivery = 'reliableOrdered', capacity = 4096 },
      { name = 'hash', delivery = 'unreliableUnordered', capacity = 64, overflow = 'dropOldest' },
    },
    events = events,
  }

  local ids: { [EventName]: integer } = {}
  local names: { [integer]: EventName } = {}
  for _, name in EventNames do
    local id = schema:eventId(name) or fail(`the schema lost the event {name}`)
    ids[name], names[id] = id, name
  end

  return { schema = schema, ids = ids, names = names }
end

-- Commands -----------------------------------------------------------------------------------

-- A ticcmd on the wire: i8 forwardmove, i8 sidemove, i16 angleturn, u8 buttons, little-endian.
function module.writeCommand(target: buffer, offset: number, command: Command): number
  buffer.writei8(target, offset, whole(command.forwardmove, 'forwardmove', -128, 127))
  buffer.writei8(target, offset + 1, whole(command.sidemove, 'sidemove', -128, 127))
  buffer.writei16(target, offset + 2, whole(command.angleturn, 'angleturn', -32768, 32767))
  buffer.writeu8(target, offset + 4, whole(command.buttons, 'buttons', 0, 255))
  return offset + module.CommandSize
end

function module.readCommand(source: buffer, offset: number): Command
  if offset + module.CommandSize > buffer.len(source) then fail('a command is cut short') end

  return {
    forwardmove = buffer.readi8(source, offset),
    sidemove = buffer.readi8(source, offset + 1),
    angleturn = buffer.readi16(source, offset + 2),
    buttons = buffer.readu8(source, offset + 4),
  }
end

function module.neutral(): Command
  return { forwardmove = 0, sidemove = 0, angleturn = 0, buttons = 0 }
end

-- CMD: u32 sequence (the sender's local tic count), then the command.
function module.encodeCmd(sequence: number, command: Command): buffer
  local target = buffer.create(4 + module.CommandSize)
  buffer.writeu32(target, 0, whole(sequence, 'sequence', 0, 4294967295))
  module.writeCommand(target, 4, command)
  return target
end

function module.decodeCmd(source: buffer): (number, Command)
  if buffer.len(source) ~= 4 + module.CommandSize then fail('CMD has the wrong size') end

  return buffer.readu32(source, 0), module.readCommand(source, 4)
end

-- Tics ---------------------------------------------------------------------------------------

local ControlKinds = { join = 1, leave = 2, map = 3, pause = 4, exit = 5 }

-- TICS: u32 tic, u8 slots present (bit per slot), u8 control count, the controls (u8 kind and
-- its operand: a slot, a map name as u8 length and bytes, a pause flag), then each present
-- slot's command in slot order.
function module.encodeTic(tic: Tic): buffer
  local parts = { string.pack('<I4', whole(tic.tic, 'tic', 0, 4294967295)) }
  local mask = 0
  for slot = 0, module.MaxPlayers - 1 do
    if tic.commands[slot] then mask += bit32.lshift(1, slot) end
  end

  if #tic.controls > 255 then fail('a tic carries at most 255 controls') end

  table.insert(parts, string.pack('<BB', mask, #tic.controls))
  for _, control in tic.controls do
    local kind = ControlKinds[control.kind] or fail(`unknown control {tostring(control.kind)}`)
    if control.kind == 'join' then
      local slot = whole(control.slot, 'slot', 0, module.MaxPlayers - 1)
      table.insert(parts, string.pack('<BBB', kind, slot, whole(control.team or 0, 'team', 0, 2)))
    elseif control.kind == 'leave' then
      table.insert(parts, string.pack('<BB', kind, whole(control.slot, 'slot', 0, module.MaxPlayers - 1)))
    elseif control.kind == 'map' then
      if #control.map > 8 or not string.match(control.map, '^[%w_]+$') then fail(`'{control.map}' is not a map name`) end

      table.insert(parts, string.pack('<Bs1', kind, control.map))
    elseif control.kind == 'pause' then
      table.insert(parts, string.pack('<BB', kind, if control.paused then 1 else 0))
    elseif control.kind == 'exit' then
      table.insert(parts, string.pack('<BB', kind, if control.secret then 1 else 0))
    end
  end

  local commands = buffer.create(module.CommandSize)
  for slot = 0, module.MaxPlayers - 1 do
    local command = tic.commands[slot]
    if not command then continue end

    module.writeCommand(commands, 0, command)
    table.insert(parts, buffer.tostring(commands))
  end

  return buffer.fromstring(table.concat(parts))
end

function module.decodeTic(source: buffer): Tic
  local length = buffer.len(source)
  if length < 6 then fail('TICS is cut short') end

  local tic, mask, count = buffer.readu32(source, 0), buffer.readu8(source, 4), buffer.readu8(source, 5)
  local at = 6
  local function byte(): number
    if at >= length then fail('TICS controls are cut short') end

    at += 1
    return buffer.readu8(source, at - 1)
  end

  local controls: { Control } = {}
  for _ = 1, count do
    local kind = byte()
    if kind == 4 then
      table.insert(controls, { kind = 'pause', paused = byte() ~= 0 } :: Control)
    elseif kind == 5 then
      table.insert(controls, { kind = 'exit', secret = byte() ~= 0 } :: Control)
    elseif kind == 3 then
      local size = byte()
      if at + size > length then fail('TICS map change is cut short') end

      table.insert(controls, { kind = 'map', map = buffer.readstring(source, at, size) } :: Control)
      at += size
    elseif kind == 1 or kind == 2 then
      local slot = byte()
      if slot >= module.MaxPlayers then fail(`TICS names slot {slot}`) end

      if kind == 2 then
        table.insert(controls, { kind = 'leave', slot = slot } :: Control)
      else
        local team = byte()
        table.insert(controls, { kind = 'join', slot = slot, team = if team > 0 then team else nil } :: Control)
      end
    else
      fail(`TICS has an unknown control {kind}`)
    end
  end

  local commands: { [number]: Command } = {}
  for slot = 0, module.MaxPlayers - 1 do
    if bit32.band(mask, bit32.lshift(1, slot)) == 0 then continue end

    commands[slot] = module.readCommand(source, at)
    at += module.CommandSize
  end

  if at ~= length then fail('TICS has bytes after its commands') end

  return { tic = tic, controls = controls, commands = commands }
end

-- Hashes -------------------------------------------------------------------------------------

-- HASH: u32 tic, u32 state hash (@doom/play's hash, as a number).
function module.encodeHash(tic: number, hash: string): buffer
  local target = buffer.create(8)
  buffer.writeu32(target, 0, whole(tic, 'tic', 0, 4294967295))
  buffer.writeu32(target, 4, tonumber(hash, 16) or fail(`'{hash}' is not a hash`))
  return target
end

function module.decodeHash(source: buffer): (number, string)
  if buffer.len(source) ~= 8 then fail('HASH has the wrong size') end

  return buffer.readu32(source, 0), string.format('%08x', buffer.readu32(source, 4))
end

-- A snapshot is the save compressed with Zstandard and sent in SNAPSHOT parts small enough for
-- one event: u32 tic, u32 the compressed size, u32 this part's offset, then its bytes.
function module.encodeSnapshot(tic: number, save: buffer): { buffer }
  local packed = bytes.zstdCompress(save)
  local total = buffer.len(packed)
  local parts = {}
  local offset = 0
  repeat
    local size = math.min(module.SnapshotPart, total - offset)
    local part = buffer.create(12 + size)
    buffer.writeu32(part, 0, whole(tic, 'tic', 0, 4294967295))
    buffer.writeu32(part, 4, total)
    buffer.writeu32(part, 8, offset)
    buffer.copy(part, 12, packed, offset, size)
    table.insert(parts, part)
    offset += size
  until offset >= total

  return parts
end

export type Assembly = { tic: number, total: number, data: buffer, received: number }

-- Adds one part to `assembly` (nil to start one); returns it, and the whole save once the last
-- part is in. Parts arrive in order on the reliable channel; one out of order is an error.
function module.addSnapshotPart(assembly: Assembly?, source: buffer): (Assembly, buffer?)
  if buffer.len(source) < 12 then fail('SNAPSHOT is cut short') end

  local tic, total, offset = buffer.readu32(source, 0), buffer.readu32(source, 4), buffer.readu32(source, 8)
  if total > module.MaxSnapshot then fail('SNAPSHOT is too large') end

  local current: Assembly
  if assembly and offset ~= 0 and assembly.tic == tic then
    current = assembly
  else
    current = { tic = tic, total = total, data = buffer.create(total), received = 0 }
  end

  local size = buffer.len(source) - 12
  if offset ~= current.received or offset + size > total then fail('SNAPSHOT parts arrived out of order') end

  buffer.copy(current.data, offset, source, 12, size)
  current.received += size
  if current.received < total then return current, nil end

  return current, bytes.zstdDecompress(current.data, { maxSize = 256 * 1024 * 1024 })
end

-- Everything else is a table of plain values in @doom/state's canonical encoding.
function module.encodeValue(value: any): buffer
  local encoded = state.encode(value)
  if buffer.len(encoded) > module.MaxControlPayload then fail('a control message is too large') end

  return encoded
end

function module.decodeValue(source: buffer): any
  return state.decode(source)
end

-- Transport ----------------------------------------------------------------------------------

export type Received = {
  kind: 'message' | 'connected' | 'disconnected' | 'rejected' | 'connectFailed',
  peer: integer,
  event: EventName?,
  payload: buffer?,
  clientId: number?,
  reason: string?,
}

-- One record from a server's or a client's queue, or nil when it is empty. A message names its
-- event and carries its payload, copied out of `scratch`.
function module.poll(protocol: Protocol, handle: dream_udp_Server | dream_udp_Client, scratch: buffer): Received?
  local kind, peer, first, second, third = (handle :: any):pollInto(scratch)
  if kind == nil then return nil end

  if kind == 'message' then
    local event = protocol.names[first :: integer]
    if not event then fail(`an unknown event id {tostring(first)}`) end

    return { kind = 'message', peer = peer :: integer, event = event, payload = bytes.slice(scratch, 0, third :: number) }
  elseif kind == 'connected' then
    return { kind = 'connected', peer = peer :: integer, clientId = integer.tonumber(first :: integer) }
  elseif kind == 'disconnected' then
    return { kind = 'disconnected', peer = peer :: integer, reason = tostring(first) }
  elseif kind == 'rejected' then
    return { kind = 'rejected', peer = peer :: integer, clientId = integer.tonumber(first :: integer), reason = tostring(second) }
  elseif kind == 'connectFailed' then
    return { kind = 'connectFailed', peer = peer :: integer, reason = tostring(first) }
  end

  return fail(`the transport returned '{tostring(kind)}'`)
end

-- A connect token as text a person can pass along, and back.
function module.tokenText(token: buffer): string
  return bytes.toBase64(token)
end

function module.tokenBytes(text: string): buffer
  local token = bytes.fromBase64((string.gsub(text, '%s', '')))
  if buffer.len(token) ~= udp.CONNECT_TOKEN_BYTES then
    fail(`a connect token is {udp.CONNECT_TOKEN_BYTES} bytes, and this one is {buffer.len(token)}`)
  end

  return token
end

return module
