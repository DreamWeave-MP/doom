--!strict
-- Generates src/play/info.jsl from Linux Doom 1.10's info.h and info.c:
--   jess run lua/tools/geninfo.jsl DOOM-master/linuxdoom-1.10 lua/src/play/info.jsl
local fs = require('@jess/fs')

local sourceDir, output = ...
local header = fs.read(`{sourceDir}/info.h`) :: string
local source = fs.read(`{sourceDir}/info.c`) :: string

local Flags = {
  MF_SPECIAL = 1,
  MF_SOLID = 2,
  MF_SHOOTABLE = 4,
  MF_NOSECTOR = 8,
  MF_NOBLOCKMAP = 16,
  MF_AMBUSH = 32,
  MF_JUSTHIT = 64,
  MF_JUSTATTACKED = 128,
  MF_SPAWNCEILING = 256,
  MF_NOGRAVITY = 512,
  MF_DROPOFF = 0x400,
  MF_PICKUP = 0x800,
  MF_NOCLIP = 0x1000,
  MF_SLIDE = 0x2000,
  MF_FLOAT = 0x4000,
  MF_TELEPORT = 0x8000,
  MF_MISSILE = 0x10000,
  MF_DROPPED = 0x20000,
  MF_SHADOW = 0x40000,
  MF_NOBLOOD = 0x80000,
  MF_CORPSE = 0x100000,
  MF_INFLOAT = 0x200000,
  MF_COUNTKILL = 0x400000,
  MF_COUNTITEM = 0x800000,
  MF_SKULLFLY = 0x1000000,
  MF_NOTDMATCH = 0x2000000,
  FRACUNIT = 65536,
}

local stateIndex: { [string]: number }, stateNames: { string } = {}, {}
local typeNames: { string } = {}

for name in string.gmatch(header, '\n%s*(S_[%w_]+),') do
  stateIndex[name] = #stateNames
  table.insert(stateNames, name)
end

for name in string.gmatch(header, '\n%s*(MT_[%w_]+),') do
  table.insert(typeNames, name)
end

local function evaluate(text: string): number | string
  if string.sub(text, 1, 4) == 'sfx_' then return `'{string.sub(text, 5)}'` end
  if stateIndex[text] then return stateIndex[text] end

  local total = 0
  for term in string.gmatch(text, '[^|]+') do
    local product = 1
    for atom in string.gmatch(term, '[^*]+') do
      atom = string.gsub(atom, '%s', '')
      local value = Flags[atom] or tonumber(atom)
      if not value then error(`geninfo: cannot evaluate '{text}'`) end
      product *= value
    end

    total += product
  end

  return total
end

local out = { '--!strict\n-- Generated by tools/geninfo.jsl from Linux Doom 1.10 info.c. Do not edit.\nlocal S = {\n' }
for index, name in stateNames do
  table.insert(out, `  {name} = {index - 1},\n`)
end

table.insert(out, '}\n\nlocal MT = {\n')
for index, name in typeNames do
  table.insert(out, `  {name} = {index - 1},\n`)
end

table.insert(out, '}\n\nlocal states = {\n')
local stateCount = 0
for sprite, frame, tics, action, nextState, misc1, misc2 in
  string.gmatch(source, '{SPR_(%w+),(%-?%d+),(%-?%d+),{([%w_]+)},(S_[%w_]+),(%-?%d+),(%-?%d+)}')
do
  local actionText = if action == 'NULL' then 'false' else `'{action}'`
  table.insert(
    out,
    `  [{stateCount}] = \{ sprite = '{sprite}', frame = {frame}, tics = {tics}, action = {actionText}, `
      .. `nextstate = {stateIndex[nextState]}, misc1 = {misc1}, misc2 = {misc2} \},\n`
  )
  stateCount += 1
end

if stateCount ~= #stateNames then error(`geninfo: parsed {stateCount} states for {#stateNames} names`) end

local Fields = {
  'doomednum',
  'spawnstate',
  'spawnhealth',
  'seestate',
  'seesound',
  'reactiontime',
  'attacksound',
  'painstate',
  'painchance',
  'painsound',
  'meleestate',
  'missilestate',
  'deathstate',
  'xdeathstate',
  'deathsound',
  'speed',
  'radius',
  'height',
  'mass',
  'damage',
  'activesound',
  'flags',
  'raisestate',
}

table.insert(out, '}\n\nlocal mobjinfo = {\n')
local tableStart = string.find(source, 'mobjinfo_t mobjinfo', 1, true) :: number
local typeCount, field = 0, 0
for line in string.gmatch(string.sub(source, tableStart), '[^\n]+') do
  local code = string.gsub(string.gsub(line, '//.*', ''), '%s', '')
  if code == '};' then break end
  if code == '' or string.find(code, 'mobjinfo', 1, true) then continue end

  if string.sub(code, 1, 1) == '{' then
    table.insert(out, `  [{typeCount}] = \{ name = '{typeNames[typeCount + 1]}', `)
    field = 0
    continue
  end

  if string.sub(code, 1, 1) == '}' then
    if field ~= #Fields then error(`geninfo: type {typeCount} has {field} fields`) end
    table.insert(out, '},\n')
    typeCount += 1
    continue
  end

  field += 1
  table.insert(out, `{Fields[field]} = {evaluate((string.gsub(code, ',$', '')))}, `)
end

if typeCount ~= #typeNames then error(`geninfo: parsed {typeCount} types for {#typeNames} names`) end

table.insert(out, '}\n\nreturn { S = S, MT = MT, states = states, mobjinfo = mobjinfo }\n')
fs.createDir(string.match(output, '^(.*)/[^/]*$') :: string)
fs.write(output, table.concat(out))
print(`wrote {stateCount} states and {typeCount} mobj types to {output}`)
